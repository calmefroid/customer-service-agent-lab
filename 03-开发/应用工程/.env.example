MODEL_MODE=mock
TEXT_MODEL_MODE=mock
MULTIMODAL_MODEL_MODE=mock
UNIFIED_MODEL_MODE=true
BUSINESS_ADAPTER=mock
KNOWLEDGE_ADAPTER=local
APP_ENV=sandbox

# 文字模型：真实 Key 只能写入 .env.local，禁止提交。
# 当 TEXT_MODEL_MODE=live 时，文字路由和低风险最终回答由真实模型生成。
TEXT_MODEL_BASE_URL=https://opai-console.opple.com/v1/chat/completions
TEXT_MODEL_API_KEY=
TEXT_MODEL_NAME=Qwen3.6-27B
# Adapter 通过 chat_template_kwargs 关闭思考，此值按最终可见内容的需求配置。
TEXT_MODEL_MAX_TOKENS=1000
MODEL_TIMEOUT_MS=30000

# 统一模型模式下，多模态复用 TEXT_MODEL_BASE_URL / API_KEY / NAME。
# 以下保留独立字段，仅在 UNIFIED_MODEL_MODE=false 时使用。
MULTIMODAL_MODEL_BASE_URL=https://opai-console.opple.com/v1/chat/completions
MULTIMODAL_MODEL_API_KEY=
MULTIMODAL_MODEL_NAME=Qwen3.6-27B
MULTIMODAL_MODEL_PROVIDER=OppleAliModelGateway
# 仅在 UNIFIED_MODEL_MODE=false 时作为独立多模态输出上限。
MULTIMODAL_MODEL_MAX_TOKENS=1000
MULTIMODAL_IMAGE_DETAIL=high
